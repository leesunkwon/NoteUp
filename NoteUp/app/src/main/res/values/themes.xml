<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NoteUp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/noteup_bg_brand</item>
        <item name="colorOnPrimary">@color/noteup_fg_neutral_inverted</item>
        <item name="colorPrimaryContainer">@color/noteup_bg_brand_weak</item>
        <item name="colorOnPrimaryContainer">@color/noteup_fg_brand</item>
        <item name="colorSurface">@color/noteup_bg_layer_default</item>
        <item name="colorOnSurface">@color/noteup_fg_neutral</item>
        <item name="colorSurfaceVariant">@color/noteup_bg_neutral_weak</item>
        <item name="colorOnSurfaceVariant">@color/noteup_fg_neutral_subtle</item>
        <item name="colorOutline">@color/noteup_stroke_neutral_weak</item>
        <item name="colorOutlineVariant">@color/noteup_stroke_neutral_muted</item>
        <item name="colorSurfaceInverse">@color/noteup_bg_neutral_inverted</item>
        <item name="colorOnSurfaceInverse">@color/noteup_fg_neutral_inverted</item>
        <item name="colorPrimaryInverse">@color/seed_carrot_500</item>
        <item name="colorError">@color/noteup_fg_critical</item>
        <item name="colorErrorContainer">@color/noteup_bg_critical_weak</item>
        <item name="android:colorBackground">@color/noteup_bg_layer_default</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NoteUp.MaterialAlertDialog</item>
        <item name="snackbarStyle">@style/Widget.NoteUp.Snackbar</item>
        <item name="textInputStyle">@style/Widget.NoteUp.TextInputLayout</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/noteup_bg_layer_default</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NoteUp" parent="Base.Theme.NoteUp" />
</resources>
