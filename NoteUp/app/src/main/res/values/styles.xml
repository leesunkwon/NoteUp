<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.NoteUp.ScreenTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/noteup_fg_neutral</item>
        <item name="android:textSize">@dimen/text_size_screen_title</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.NoteUp.SectionTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/noteup_fg_neutral</item>
        <item name="android:textSize">@dimen/text_size_section_title</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.NoteUp.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/noteup_fg_neutral</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.NoteUp.BodyStrong" parent="TextAppearance.NoteUp.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.NoteUp.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/noteup_fg_neutral</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.NoteUp.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/noteup_fg_neutral_subtle</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.NoteUp.CaptionSmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/noteup_fg_neutral_muted</item>
        <item name="android:textSize">@dimen/text_size_caption_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Compatibility names used by existing layouts. -->
    <style name="TextAppearance.NoteUp.Title" parent="TextAppearance.NoteUp.ScreenTitle" />
    <style name="TextAppearance.NoteUp.Heading" parent="TextAppearance.NoteUp.SectionTitle" />

    <style name="Widget.NoteUp.Button.Base" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAppearance">@style/TextAppearance.NoteUp.Label</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.NoteUp.Button.Primary" parent="Widget.NoteUp.Button.Base">
        <item name="backgroundTint">@color/noteup_button_brand_background</item>
        <item name="android:textColor">@color/noteup_button_brand_foreground</item>
        <item name="iconTint">@color/noteup_button_brand_foreground</item>
    </style>

    <style name="Widget.NoteUp.Button.Secondary" parent="Widget.NoteUp.Button.Base">
        <item name="backgroundTint">@color/noteup_button_neutral_background</item>
        <item name="android:textColor">@color/noteup_control_text</item>
        <item name="iconTint">@color/noteup_control_text</item>
    </style>

    <style name="Widget.NoteUp.Button.Critical" parent="Widget.NoteUp.Button.Base">
        <item name="backgroundTint">@color/noteup_button_critical_background</item>
        <item name="android:textColor">@color/noteup_fg_neutral_inverted</item>
    </style>

    <style name="Widget.NoteUp.Button.Tool" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAppearance">@style/TextAppearance.NoteUp.Label</item>
        <item name="backgroundTint">@color/noteup_tool_background</item>
        <item name="android:textColor">@color/noteup_tool_text</item>
        <item name="cornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.NoteUp.Button.Utility" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAppearance">@style/TextAppearance.NoteUp.Label</item>
        <item name="backgroundTint">@color/noteup_utility_background</item>
        <item name="android:textColor">@color/noteup_control_text</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.NoteUp.Button.IconTool" parent="Widget.NoteUp.Button.Tool">
        <item name="android:minWidth">@dimen/control_height</item>
        <item name="android:padding">@dimen/toolbar_icon_padding</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/toolbar_icon_size</item>
        <item name="iconTint">@color/noteup_tool_text</item>
    </style>

    <style name="Widget.NoteUp.Button.IconUtility" parent="Widget.NoteUp.Button.Utility">
        <item name="android:minWidth">@dimen/control_height</item>
        <item name="android:padding">@dimen/toolbar_icon_padding</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/toolbar_icon_size</item>
        <item name="iconTint">@color/noteup_control_text</item>
    </style>

    <style name="Widget.NoteUp.Button.ColorSwatch" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/control_height</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:minWidth">@dimen/control_height</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:insetLeft">10dp</item>
        <item name="android:insetTop">10dp</item>
        <item name="android:insetRight">10dp</item>
        <item name="android:insetBottom">10dp</item>
        <item name="cornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/tool_swatch_check_size</item>
        <item name="strokeColor">@color/noteup_stroke_brand</item>
    </style>

    <style name="Widget.NoteUp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/noteup_bg_layer_default</item>
        <item name="boxCornerRadiusTopStart">@dimen/seed_radius_r3</item>
        <item name="boxCornerRadiusTopEnd">@dimen/seed_radius_r3</item>
        <item name="boxCornerRadiusBottomStart">@dimen/seed_radius_r3</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/seed_radius_r3</item>
        <item name="boxStrokeColor">@color/noteup_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/hairline_width</item>
        <item name="boxStrokeWidthFocused">@dimen/focus_stroke_width</item>
        <item name="hintTextColor">@color/noteup_fg_neutral_muted</item>
        <item name="endIconTint">@color/noteup_control_text</item>
    </style>

    <style name="ShapeAppearance.NoteUp.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/seed_radius_r4</item>
    </style>

    <style name="Widget.NoteUp.Button.Dialog.Primary" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/noteup_button_brand_background</item>
        <item name="android:textColor">@color/noteup_button_brand_foreground</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/control_height</item>
    </style>

    <style name="Widget.NoteUp.Button.Dialog.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/noteup_button_neutral_background</item>
        <item name="android:textColor">@color/noteup_control_text</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/control_height</item>
    </style>

    <style name="ThemeOverlay.NoteUp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/noteup_bg_layer_default</item>
        <item name="colorOnSurface">@color/noteup_fg_neutral</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NoteUp.Button.Dialog.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NoteUp.Button.Dialog.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NoteUp.Button.Dialog.Secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NoteUp.Dialog</item>
    </style>

    <style name="Widget.NoteUp.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/noteup_bg_neutral_inverted</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NoteUp.Snackbar</item>
    </style>

    <style name="ShapeAppearance.NoteUp.Snackbar" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/seed_radius_r2</item>
    </style>
</resources>
