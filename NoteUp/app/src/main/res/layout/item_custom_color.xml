<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/control_height"
    android:orientation="horizontal">

    <View
        android:id="@+id/color_swatch"
        android:layout_width="@dimen/color_manage_swatch_size"
        android:layout_height="@dimen/color_manage_swatch_size"
        android:background="@drawable/bg_tool_swatch" />

    <TextView
        android:id="@+id/color_hex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete_button"
        style="@style/Widget.NoteUp.Button.IconUtility"
        android:layout_width="@dimen/control_height"
        android:layout_height="@dimen/control_height"
        android:contentDescription="@string/delete_custom_color"
        app:icon="@drawable/ic_delete" />
</LinearLayout>
