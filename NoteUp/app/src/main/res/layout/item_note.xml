<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/note_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/seed_dimension_x1_5"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/noteup_bg_layer_default"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:rippleColor="@color/noteup_bg_neutral_pressed"
    app:strokeColor="@color/noteup_stroke_neutral_muted"
    app:strokeWidth="@dimen/hairline_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/note_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_note_preview"
            android:contentDescription="@string/blank_page_preview"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/note_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/seed_dimension_x3"
            android:paddingTop="@dimen/seed_dimension_x3"
            android:paddingBottom="@dimen/seed_dimension_x3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/note_preview"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong"
                    tools:text="회의 기록" />

                <TextView
                    android:id="@+id/note_modified_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/seed_dimension_x1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.NoteUp.CaptionSmall"
                    tools:text="수정 2026. 7. 12." />
            </LinearLayout>

            <ImageButton
                android:id="@+id/note_more_button"
                android:layout_width="@dimen/control_height"
                android:layout_height="@dimen/control_height"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="@dimen/seed_dimension_x3"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/noteup_control_text" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
