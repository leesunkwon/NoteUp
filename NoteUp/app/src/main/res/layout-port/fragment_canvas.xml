<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noteup_bg_layer_basement"
    tools:context=".ui.canvas.CanvasFragment">

    <LinearLayout
        android:id="@+id/canvas_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/canvas_toolbar_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_button"
                style="@style/Widget.NoteUp.Button.IconUtility"
                android:layout_width="@dimen/control_height"
                android:layout_height="@dimen/control_height"
                app:icon="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/note_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong"
                tools:text="새 노트" />

            <TextView
                android:id="@+id/export_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:minWidth="@dimen/export_status_width"
                android:textColor="@color/noteup_fg_neutral_muted"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/more_button"
                style="@style/Widget.NoteUp.Button.IconUtility"
                android:layout_width="@dimen/control_height"
                android:layout_height="@dimen/control_height"
                app:icon="@drawable/ic_more_vert" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/canvas_tool_row_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pen_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_pen" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/highlighter_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_highlighter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/eraser_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_eraser" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lasso_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_lasso" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shape_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_shape" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_tool_button"
                        style="@style/Widget.NoteUp.Button.IconTool"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        app:icon="@drawable/ic_tool_text" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tool_settings_button"
                        android:layout_width="@dimen/control_height"
                        android:layout_height="@dimen/control_height"
                        android:layout_marginStart="@dimen/spacing_extra_small"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:cardBackgroundColor="@color/noteup_bg_neutral_weak"
                        app:cardCornerRadius="@dimen/chip_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/noteup_stroke_neutral_weak"
                        app:strokeWidth="@dimen/hairline_width">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small">

                            <LinearLayout
                                android:id="@+id/current_style_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/current_color_swatch"
                                    android:layout_width="@dimen/tool_current_swatch_size"
                                    android:layout_height="@dimen/tool_current_swatch_size"
                                    android:background="@drawable/bg_tool_swatch" />

                                <View
                                    android:id="@+id/current_thickness_preview"
                                    android:layout_width="@dimen/tool_current_line_width"
                                    android:layout_height="@dimen/tool_preview_medium"
                                    android:layout_marginStart="@dimen/spacing_extra_small"
                                    android:background="@drawable/bg_tool_line_preview" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/current_tool_setting_icon"
                                android:layout_width="@dimen/toolbar_icon_size"
                                android:layout_height="@dimen/toolbar_icon_size"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tool_eraser"
                                android:visibility="gone"
                                app:tint="@color/noteup_control_text" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undo_button"
                style="@style/Widget.NoteUp.Button.IconUtility"
                android:layout_width="@dimen/control_height"
                android:layout_height="@dimen/control_height"
                android:enabled="false"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/redo_button"
                style="@style/Widget.NoteUp.Button.IconUtility"
                android:layout_width="@dimen/control_height"
                android:layout_height="@dimen/control_height"
                android:enabled="false"
                app:icon="@drawable/ic_redo" />
        </LinearLayout>
    </LinearLayout>

    <com.kotlinsun.noteup.ui.canvas.DrawingCanvasView
        android:id="@+id/drawing_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/noteup_bg_layer_basement"
        android:contentDescription="@string/canvas_title"
        app:layout_constraintBottom_toTopOf="@id/page_navigation_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/canvas_toolbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selection_actions_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/noteup_bg_layer_default"
        app:cardCornerRadius="@dimen/chip_corner_radius"
        app:cardElevation="@dimen/tool_popup_elevation"
        app:layout_constraintStart_toStartOf="@id/drawing_canvas"
        app:layout_constraintTop_toTopOf="@id/drawing_canvas"
        app:strokeColor="@color/noteup_stroke_neutral_weak"
        app:strokeWidth="@dimen/hairline_width">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_extra_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_text_button"
                style="@style/Widget.NoteUp.Button.Utility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_text"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copy_selection_button"
                style="@style/Widget.NoteUp.Button.Utility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copy_selection"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paste_selection_button"
                style="@style/Widget.NoteUp.Button.Utility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paste_selection"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_selection_button"
                style="@style/Widget.NoteUp.Button.Utility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_selection"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/page_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_hairline"
        android:minHeight="@dimen/page_navigation_height"
        android:paddingHorizontal="@dimen/spacing_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/page_list_button"
            style="@style/Widget.NoteUp.Button.Utility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_list"
            app:icon="@drawable/ic_pages"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previous_page_button"
            style="@style/Widget.NoteUp.Button.Utility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/previous_page"
            android:visibility="gone" />

        <TextView
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="@dimen/page_indicator_width"
            android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong"
            android:visibility="gone"
            tools:text="1 / 3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_page_button"
            style="@style/Widget.NoteUp.Button.Utility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_page"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/zoom_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/noteup_bg_neutral_weak"
            app:cardCornerRadius="@dimen/zoom_floating_corner_radius"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/noteup_stroke_neutral_muted"
            app:strokeWidth="@dimen/hairline_width">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_out_button"
                    style="@style/Widget.NoteUp.Button.IconUtility"
                    android:layout_width="@dimen/control_height"
                    android:layout_height="@dimen/control_height"
                    android:contentDescription="@string/zoom_out"
                    android:text="@string/zoom_out_symbol" />

                <TextView
                    android:id="@+id/zoom_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="@dimen/zoom_percentage_width"
                    android:text="@string/zoom_percentage_default"
                    android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong"
                    tools:text="125%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_reset_button"
                    style="@style/Widget.NoteUp.Button.Utility"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_height"
                    android:contentDescription="@string/zoom_reset"
                    android:minWidth="@dimen/control_height"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:text="@string/zoom_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_in_button"
                    style="@style/Widget.NoteUp.Button.IconUtility"
                    android:layout_width="@dimen/control_height"
                    android:layout_height="@dimen/control_height"
                    android:contentDescription="@string/zoom_in"
                    android:text="@string/zoom_in_symbol" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_page_button"
            style="@style/Widget.NoteUp.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_page"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/page_panel"
        android:layout_width="0dp"
        android:layout_height="@dimen/page_panel_portrait_height"
        android:visibility="gone"
        app:cardBackgroundColor="@color/noteup_bg_layer_default"
        app:cardCornerRadius="@dimen/seed_radius_r4"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/page_navigation_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/noteup_stroke_neutral_weak"
        app:strokeWidth="@dimen/hairline_width"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_medium">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/page_list"
                    android:textAppearance="@style/TextAppearance.NoteUp.BodyStrong" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/close_page_panel_button"
                    style="@style/Widget.NoteUp.Button.Utility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/close" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/page_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_small"
                tools:listitem="@layout/item_page_thumbnail" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/drawing_canvas"
        app:layout_constraintEnd_toEndOf="@id/drawing_canvas"
        app:layout_constraintStart_toStartOf="@id/drawing_canvas"
        app:layout_constraintTop_toTopOf="@id/drawing_canvas" />

    <LinearLayout
        android:id="@+id/not_found_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/drawing_canvas"
        app:layout_constraintEnd_toEndOf="@id/drawing_canvas"
        app:layout_constraintStart_toStartOf="@id/drawing_canvas"
        app:layout_constraintTop_toTopOf="@id/drawing_canvas"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/canvas_not_found_title"
            android:textAppearance="@style/TextAppearance.NoteUp.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/canvas_not_found_description"
            android:textAppearance="@style/TextAppearance.NoteUp.Body" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
